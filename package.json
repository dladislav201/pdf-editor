{
  "name": "pdf-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/editor",
    "packages/react",
    "apps/demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/demo",
    "build": "npm run build --workspace=packages/editor && npm run build --workspace=packages/react && npm run build --workspace=apps/demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy:demo": "npm run deploy --workspace=apps/demo",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "stats": "npm run stats -w apps/demo --silent",
    "errors": "npm run errors -w apps/demo --silent",
    "feedback": "npm run feedback -w apps/demo --silent"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
