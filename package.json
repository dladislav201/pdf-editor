{
  "name": "pdf-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/editor",
    "packages/react",
    "apps/demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/demo",
    "build": "npm run build --workspace=packages/editor && npm run build --workspace=packages/react && npm run build --workspace=apps/demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy:demo": "npm run deploy --workspace=apps/demo",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13"
  }
}
