{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node ../../scripts/copy-pdfjs-assets.mjs public/pdfjs && mkdir -p public/fonts && cp ../../node_modules/dejavu-fonts-ttf/ttf/DejaVuSans.ttf public/fonts/",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdfsdk/editor": "0.1.0",
    "@pdfsdk/react": "0.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
