{
  "name": "@pdfsdk/editor",
  "version": "0.1.0",
  "description": "Embeddable web PDF editor: viewing, annotations, export.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdfjs/*": "./dist/pdfjs/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/copy-pdfjs-assets.mjs dist/pdfjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
