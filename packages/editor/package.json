{
  "name": "@pdfsdk/editor",
  "version": "0.1.0",
  "description": "Embeddable web PDF editor: viewing, annotations, export.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine/*": "./dist/engine/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/copy-engine-assets.mjs dist/engine",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@expo-google-fonts/arimo": "^0.4.2",
    "@expo-google-fonts/cousine": "^0.4.2",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "harfbuzzjs": "^1.6.3",
    "pdf-lib": "^1.17.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "@types/node": "^22.20.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
